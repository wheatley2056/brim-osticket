<Project Sdk="Microsoft.NET.Sdk">
  <!--
    osTicket-Plugin für Brim: offene und eigene Tickets in der Notch, neue Tickets als kurze Meldung, Ticketliste und
    Übersicht als Widgets auf „Jetzt“. Liest über das Agenten-Panel (/scp) von osTicket, angemeldet als Agent; die
    offizielle API von osTicket kann nur Tickets anlegen. Build-Ausgabe ist der fertige Plugin-Ordner.
  -->
  <PropertyGroup>
    <!-- Kein Konsolenfenster, wenn Brim das Plugin startet; stdout/stderr landen trotzdem im Plugin-Log. -->
    <OutputType>WinExe</OutputType>
    <!-- Nur HTTP, kein Win32: läuft und testet auch außerhalb von Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BrimOsTicket</AssemblyName>
    <RootNamespace>Brim.OsTicket</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BrimRoot)\src\Brim.Sdk\Brim.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
